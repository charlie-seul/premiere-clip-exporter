{
  "manifestVersion": 5,
  "id": "org.premiereclipexporter.panel",
  "name": "Premiere Clip Exporter",
  "version": "0.2.1",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "27.0.0"
  },
  "requiredPermissions": {
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "clipExporterPanel",
      "label": {
        "default": "Clip Exporter"
      },
      "minimumSize": {
        "width": 340,
        "height": 500
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 700
      }
    }
  ]
}
